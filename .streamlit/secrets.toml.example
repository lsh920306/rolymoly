# Supabase 프로젝트 → Connect → Session pooler → 연결 매개변수를 복사하세요.
# 이 예시 파일에는 실제 비밀번호를 넣지 마세요.
# 실제 입력 파일: .streamlit/secrets.toml (Git/배포 ZIP 제외)
# test/production은 공용 Supabase만 사용하며 체험 공간과 체험 계정을 차단합니다.
[app]
environment = "test" # 검수 배포: test / 정식 운영: production / 명시적 로컬 개발: local
# 항목을 생략하면 production입니다. test는 화면에 '검수용' 배지를 표시합니다.
# ROLYMOLY_APP_ENVIRONMENT는 같은 세 값 중 하나로 프로세스 모드를 고정합니다.
# Supabase target 없이 ROLYMOLY_DATA_DIR을 직접 지정하면 격리 로컬 개발로 처리합니다.

[supabase]
host = ""          # 예: aws-0-ap-northeast-2.pooler.supabase.com
port = 5432        # Session pooler 포트 (6543 아님)
database = "postgres"
user = ""          # Connect 화면의 postgres.프로젝트참조ID
password = ''      # 프로젝트 DB 비밀번호. Supabase 로그인 비밀번호/API 키 아님.
# 작은따옴표 문자열 안의 @, #, $, 역슬래시는 그대로 입력합니다.
# 비밀번호에 작은따옴표가 있다면 큰따옴표 문자열과 TOML 이스케이프를 사용하세요.

[riot]
api_key = ""      # 실제 키는 .streamlit/secrets.toml 또는 배포 앱의 Secrets에 입력
allow_demo = false # 배포 후 false 유지. 로컬 배포 전 리허설에서만 true.
# KR 서버 솔로·자유랭크 + 챔피언 숙련도 상위 5개. 빈 값이면 API 조회를 사용하지 않습니다.
# 1초 20회 / 2분 100회 제한은 앱에서 공동 관리합니다.
